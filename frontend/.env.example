# Copy to frontend/.env.local for local dev, or set as a CI variable for deploys.
# This is the API Gateway *stage* invoke URL (the `api_gateway_invoke_url` Terraform output),
# WITHOUT a trailing /api — the app appends /api/... itself.
# Example:
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
